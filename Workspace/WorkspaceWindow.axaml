<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameMockStudio.Workspace.WorkspaceWindow"
        Title="Mosaic — モックスタジオ" Width="1440" Height="940" MinWidth="1140" MinHeight="720">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="5" MaxWidth="750" HorizontalAlignment="Left">
        <TextBlock Classes="caption" Text="MOSAIC  /  IDEA TO EXPERIENCE" />
        <TextBlock x:Name="HeadingText" Text="思いついたところから、ゲームに。" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="決めたい要素だけ入力。空欄はAIがランダムに決定します。「なし」は不採用の指定です。" />
      </StackPanel>
      <TextBlock x:Name="SaveStatusText" Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,8,0,0"
                 Text="前回の入力を確認しています…" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ComboBox x:Name="KindSelector" SelectedIndex="0" MinWidth="170" AutomationProperties.Name="企画の種類">
          <ComboBoxItem Content="ゲーム" />
          <ComboBoxItem Content="サービス" />
          <ComboBoxItem Content="ゲーミフィケーション" />
        </ComboBox>
        <Button x:Name="NewButton" Content="新しい企画" />
        <Button x:Name="LoadButton" Content="企画を開く" />
        <Button x:Name="SaveButton" Content="企画を保存" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="218,18,*,18,350">
      <Border Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock x:Name="PlanningLabelText" Classes="caption" Margin="8,4,0,8" Text="01  /  ゲームの設計" TextWrapping="Wrap" />
          <TextBlock x:Name="CompletionText" Grid.Row="1" Margin="8,0,0,14" Classes="muted" TextWrapping="Wrap" />
          <ListBox x:Name="CategoryList" Grid.Row="2" Background="Transparent" BorderThickness="0" />
        </Grid>
      </Border>
      <TabControl x:Name="EditorTabs" Grid.Column="2">
        <TabItem Header="企画をつくる">
          <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
            <TextBox x:Name="SearchBox" PlaceholderText="項目を検索" Margin="0,0,0,14" />
            <ScrollViewer x:Name="EditorScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="EditorHost" Spacing="12" Margin="0,0,8,0" />
            </ScrollViewer>
          </Grid>
        </TabItem>
        <TabItem Header="モックの感想">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,16,8,0">
              <TextBlock Text="使った感想から、もう一歩。" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="右の生成履歴でモックを選び、よかった点や変えたい点を書いてください。元のモックを残して改善版を作ります。" TextWrapping="Wrap" />
              <Border Classes="card" Padding="14">
                <TextBlock x:Name="FeedbackTargetText" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="使った感想・改善要望" FontWeight="SemiBold" />
              <TextBox x:Name="FeedbackBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260"
                       AutomationProperties.Name="使った感想・改善要望"
                       PlaceholderText="例: 最初の操作は分かりやすかった。結果がどう変わったか見えにくいので改善したい。試した仮説に対する気づきも書けます。"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
              <TextBlock Classes="muted" Text="感想はモックごとに自動保存します。今回の要望を優先し、関係のない仕様は引き継ぎます。種類と生成形式は選択したモックと同じです。" TextWrapping="Wrap" />
              <TextBlock x:Name="AppliedFeedbackText" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="アイデアを探す">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Margin="0,16,8,0">
              <TextBlock Text="次に何を作るか、ここから。" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="上の種類を切り替え、検討の出発点を選びます。SNSにするか、困りごとを解決する道具にするか。ゲームならどの場面を変えられるか。案はすべて編集できます。" TextWrapping="Wrap" />
              <TextBlock Text="検討の出発点" FontWeight="SemiBold" />
              <ComboBox x:Name="IdeaSelector" HorizontalAlignment="Stretch" AutomationProperties.Name="検討の出発点" />
              <Border Classes="card" Padding="20">
                <TextBlock x:Name="IdeaDescriptionText" TextWrapping="Wrap" FontSize="16" LineHeight="28" />
              </Border>
              <TextBlock Classes="muted" Text="これらは効果が未検証の仮説です。誰のどんな場面を変えたいか、自分の観察に合わせて書き換えてください。サービスとゲーミフィケーションは、試し方と次の判断をまとめた検証メモも生成します。" TextWrapping="Wrap" />
              <Button x:Name="ApplyIdeaButton" Classes="primary" Content="この案から新しい企画をつくる  →" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,14" />
              <TextBlock Classes="muted" Text="現在の種類の企画を選んだ案に置き換えます。直前の入力は復旧フォルダへ退避します。他の種類の下書きは保持します。空欄のまま自由に企画を始めることもできます。" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Column="4" Classes="card" Padding="18">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
          <StackPanel x:Name="ConfigurationPanel" Spacing="10">
            <TextBlock Classes="caption" Text="02  /  モックを生成" />
            <TextBlock Text="Codex GPT-6  ·  xhigh" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="muted" Text="このPCのログイン済みCodex CLIで生成します。認証情報はアプリに保存しません。生成にはネット接続を使用します。" TextWrapping="Wrap" />
            <TextBlock Text="新規生成するモックの形式" Margin="0,6,0,0" />
            <ComboBox x:Name="FormatSelector" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="ブラウザ（HTML）" />
              <ComboBoxItem x:Name="UnityFormatItem" Content="Unity プロジェクト" />
              <ComboBoxItem Content="Avalonia プロジェクト" />
            </ComboBox>
            <TextBlock Text="出力先" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="OutputRootBox" PlaceholderText="絶対パス" />
              <Button x:Name="ChooseOutputButton" Grid.Column="1" Content="選択" Margin="6,0,0,0" />
            </Grid>
            <Expander Header="Codexの接続設定" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Classes="muted" Text="CLI実行ファイルのパス" />
                <TextBox x:Name="ExecutableBox" PlaceholderText="codex" />
                <TextBlock Classes="muted" Text="モデル: gpt-6-astra / 推論: xhigh" FontSize="11" />
              </StackPanel>
            </Expander>
            <Expander Header="生成履歴・復旧" HorizontalAlignment="Stretch" IsExpanded="True">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <ComboBox x:Name="HistorySelector" HorizontalAlignment="Stretch" MaxDropDownHeight="240"
                          PlaceholderText="生成履歴はまだありません" />
                <Button x:Name="UseResolvedButton" Content="補完済み企画で編集する" IsEnabled="False"
                        HorizontalAlignment="Stretch" />
                <Button x:Name="OpenRecoveryButton" Content="退避した企画を探す" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <TextBlock Classes="caption" Text="03  /  確認と進行" Margin="0,20,0,10" />
          <TabControl x:Name="OutputTabs" Height="250">
            <TabItem Header="生成指示">
              <TextBox x:Name="PromptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontSize="11" BorderThickness="0" Background="Transparent"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="実行ログ">
              <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontSize="11" BorderThickness="0" Background="Transparent"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </TabItem>
          </TabControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
            <Button x:Name="GenerateButton" Classes="primary" Content="ゲームモックを生成  →" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="12,14" />
            <Button x:Name="RefineButton" Classes="primary" Content="この感想でブラッシュアップ  →"
                    IsVisible="False" IsEnabled="False" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Padding="12,14" />
            <Button x:Name="CancelButton" Content="生成をキャンセル" IsVisible="False" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Grid ColumnDefinitions="*,*">
              <Button x:Name="OpenOutputButton" Content="成果物フォルダ" IsEnabled="False" HorizontalAlignment="Stretch" />
              <Button x:Name="PlayButton" Grid.Column="1" Content="モックを開く" IsEnabled="False"
                      HorizontalAlignment="Stretch" Margin="6,0,0,0" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Text="準備完了。すべて空欄でも生成できます。" TextWrapping="Wrap" />
      <TextBlock x:Name="OutputPathText" Grid.Row="1" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
    </Grid>
  </Grid>
</Window>
